{
  "world": {
    "distDir": "./dist",
    "title": "XRDOOM",
    "description": "DOOMをXRiftでプレイできます。WebRTCで低遅延配信もされるのでみんなで観戦できます（doomgeneric使用／DOOMシェアウェア版）\n\nXRDOOMは、DOOMの権利者およびXRift非公認のファンプロジェクトです。",
    "buildCommand": "npm run build",
    "ignore": [
      "**/.DS_Store",
      "**/Thumbs.db",
      "**/*.js.map",
      "**/.gitkeep",
      "**/index.html",
      "**/__federation_shared_@react-three/drei-*.js",
      "**/__federation_shared_@react-three/fiber-*.js",
      "**/__federation_shared_@react-three/rapier-*.js",
      "**/__federation_shared_@xrift/world-components-*.js",
      "**/__federation_shared_three-*.js",
      "**/__federation_shared_three/addons/**",
      "**/__federation_shared_react-*.js",
      "**/__federation_shared_react-dom-*.js",
      "**/__federation_shared_react-dom/client-*.js",
      "**/__federation_shared_react/jsx-runtime-*.js",
      "**/rapier.es-*.js",
      "**/hls-*.js"
    ],
    "physics": {
      "gravity": 9.81,
      "allowInfiniteJump": false
    },
    "camera": {
      "near": 0.05,
      "far": 50
    },
    "permissions": {
      "allowedDomains": [
        "wss.vdo.ninja",
        "turnservers.vdo.ninja",
        "stun.l.google.com",
        "stun.cloudflare.com",
        "turn-pl2.vdo.ninja",
        "turn-usw5.vdo.ninja"
      ],
      "allowedCodeRules": [
        "no-rtc-connection",
        "no-network-without-permission",
        "no-obfuscation"
      ]
    }
  }
}
